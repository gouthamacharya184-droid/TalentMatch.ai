# ==============================================================================
# TalentMatch.ai - Enterprise Production Environment Configuration
# ==============================================================================
# Copy this template to .env for local development.
# In Vercel, configure these variables in: Project Settings -> Environment Variables.

# ------------------------------------------------------------------------------
# 1. ENVIRONMENT & RUNTIME
# ------------------------------------------------------------------------------
# Set to 'production' in production deployments.
# The app will fail-fast at startup if ENVIRONMENT=production and DATABASE_URL is SQLite.
ENVIRONMENT=development
DEBUG=false
HOST=127.0.0.1
PORT=8000

# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION (Persistent PostgreSQL via Neon / Supabase)
# ------------------------------------------------------------------------------
# Production: Requires PostgreSQL with SSL. SQLite in production will fail at startup.
# Neon Example:
# DATABASE_URL=postgresql://user:password@ep-xyz.us-east-2.aws.neon.tech/talentmatch?sslmode=require
# Supabase Example:
# DATABASE_URL=postgresql://postgres:password@db.xyz.supabase.co:5432/postgres?sslmode=require
# Local Development (SQLite fallback):
DATABASE_URL=sqlite:///./talentmatch.db

# ------------------------------------------------------------------------------
# 3. DISTRIBUTED RATE LIMITING (Redis / Upstash for Serverless)
# ------------------------------------------------------------------------------
# For multi-instance Vercel serverless deployments, provide an Upstash or Redis URL.
# If omitted, an in-memory sliding window limiter is used automatically for local dev.
# Upstash Example:
# REDIS_URL=rediss://default:your-token@your-upstash-instance.upstash.io:6379
REDIS_URL=

# ------------------------------------------------------------------------------
# 4. SECURITY & AUTHENTICATION (JWT)
# ------------------------------------------------------------------------------
# A cryptographically strong random string (minimum 32 characters: openssl rand -hex 32)
SECRET_KEY=change-this-to-a-secure-random-32-char-secret-key-for-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7

# ------------------------------------------------------------------------------
# 5. OBSERVABILITY & ERROR TRACKING (Sentry)
# ------------------------------------------------------------------------------
# Optional Sentry DSN for centralized exception monitoring and performance tracing
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

# ------------------------------------------------------------------------------
# 6. CLOUD FILE STORAGE (Vercel Blob)
# ------------------------------------------------------------------------------
# Obtained automatically when attaching Vercel Blob store to your Vercel project:
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxxxxxxxxxxxxxxxxxxxxxxx
BLOB_READ_WRITE_TOKEN=

# Local storage fallback directory (defaults to /tmp/uploads on Vercel)
UPLOAD_DIR=../storage/uploads
MAX_FILE_SIZE_MB=15
MAX_BATCH_SIZE=50

# ------------------------------------------------------------------------------
# 7. AI & SEMANTIC ENGINE (Google Gemini / OpenAI / SentenceTransformers)
# ------------------------------------------------------------------------------
LLM_ENABLED=true
LLM_API_KEY=your_gemini_api_key_here
LLM_MODEL=gemini-2.5-flash
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ------------------------------------------------------------------------------
# 8. FRONTEND & API CONFIGURATION
# ------------------------------------------------------------------------------
FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
