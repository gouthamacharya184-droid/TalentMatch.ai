# ==============================================================================
# TalentMatch.ai - Enterprise Production Environment Configuration
# ==============================================================================
# Copy this template to .env for local development.
# In Vercel, configure these variables in: Project Settings -> Environment Variables.

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (Persistent PostgreSQL via Vercel Integration / Neon)
# ------------------------------------------------------------------------------
# Production (PostgreSQL on Neon / Supabase / Vercel Marketplace):
# DATABASE_URL=postgresql://user:password@ep-cool-sample.us-east-2.aws.neon.tech/talentmatch?sslmode=require
# Local Development (SQLite):
DATABASE_URL=sqlite:///./talentmatch.db

# ------------------------------------------------------------------------------
# 2. SECURITY & AUTHENTICATION (JWT)
# ------------------------------------------------------------------------------
# A cryptographically strong random string (minimum 32 characters)
SECRET_KEY=change-this-to-a-secure-random-32-char-secret-key-for-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7

# ------------------------------------------------------------------------------
# 3. CLOUD FILE STORAGE (Vercel Blob)
# ------------------------------------------------------------------------------
# Obtained automatically when attaching Vercel Blob store to your Vercel project:
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxxxxxxxxxxxxxxxxxxxxxxx
BLOB_READ_WRITE_TOKEN=

# Local storage fallback directory (defaults to /tmp/uploads on Vercel)
UPLOAD_DIR=../storage/uploads
MAX_FILE_SIZE_MB=15
MAX_BATCH_SIZE=50

# ------------------------------------------------------------------------------
# 4. AI & SEMANTIC ENGINE (Google Gemini / OpenAI / SentenceTransformers)
# ------------------------------------------------------------------------------
LLM_ENABLED=true
# Paste your Google Gemini API key or OpenAI key
LLM_API_KEY=your_gemini_api_key_here
LLM_MODEL=gemini-2.5-flash
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ------------------------------------------------------------------------------
# 5. FRONTEND & API CONFIGURATION
# ------------------------------------------------------------------------------
# In unified Vercel deployments, relative '/api' is used by default.
# VITE_API_URL=/api
FRONTEND_URL=http://localhost:5173

# Server host & port (for local uvicorn runs)
HOST=0.0.0.0
PORT=8000
DEBUG=false
