# ==============================================================================
# TalentMatch.ai Backend Environment Configuration (.env.example)
# ==============================================================================

# Database: PostgreSQL in production (Neon / Supabase / Vercel Postgres)
# Local development defaults to sqlite:///./talentmatch.db if unset
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Security: REQUIRED in production (minimum 32 characters, cryptographically random)
SECRET_KEY=generate-a-secure-random-32-character-secret-key-for-jwt-signing

# Vercel Blob: for cloud resume persistence (from Vercel Blob Store dashboard)
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxxxxxxxxxxxxxxxxxxxxxxx

# AI & LLM: Google Gemini API key for semantic embeddings & intelligence
LLM_API_KEY=your_gemini_api_key_here
LLM_MODEL=gemini-2.5-flash
LLM_ENABLED=true

# CORS: Comma-separated list of allowed origins (leave blank for same-origin Vercel)
ALLOWED_ORIGINS=https://talent-match-ai-lime.vercel.app,http://localhost:5173

# Local storage fallback directory (defaults to /tmp/uploads on Vercel)
UPLOAD_DIR=/tmp/uploads
MAX_FILE_SIZE_MB=4.5
