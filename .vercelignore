# Vercel Deployment Ignore Rules

# Dependencies & Virtual Environments
frontend/node_modules/
.venv/
venv/
backend/venv/

# Tests & Test Fixtures (not needed in production bundle)
backend/tests/
test_resumes_50/
test_resumes_edge_cases/
sample_jobs/

# Local Storage, Databases & Backups
storage/uploads/
storage/uploads/*
!storage/uploads/.gitkeep
backend/uploads/
backend/uploads/*
uploads/
uploads/*
backups/
*.db
*.sqlite3
*.db-journal
*.db-wal
*.db-shm
*.bak

# Cache & Logs
__pycache__/
*.pyc
*.log
logs/
.pytest_cache/

# Documentation & Screenshots
docs/
screenshots/

# Agent Tooling & Metadata
.agent/
.agents/
.gsd/
.gemini/
